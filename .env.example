# ==============================================================================
# REQUIRED
# ==============================================================================

# Envio HyperSync API token.
ENVIO_API_TOKEN=your_envio_api_token_here

# Disable Hasura GraphQL entirely (default for this indexer — bot reads Postgres directly).
# `bun run dev` also forces this off.
ENVIO_HASURA=false

# Comma-separated archival Polygon RPCs for Effect metadata (decimals, Curve/Balancer/…).
# Resolution order in rpc_client.ts: ENVIO_POLYGON_RPC_URLS → ENVIO_POLYGON_RPC_URL →
# POLYGON_RPC_URLS → POLYGON_RPC_URL → POLYGON_RPC. Only configured URLs are used (no public
# append). Remove dead/401/403 endpoints — they stall every Effect call via viem fallback().
# `bun run dev` bridges POLYGON_RPC_URLS / POLYGON_RPC_URL / POLYGON_RPC → ENVIO_*.
ENVIO_POLYGON_RPC_URLS=https://your-archival-rpc.example.com

# ==============================================================================
# HYPERSYNC / BATCHING (config.yaml interpolation)
# ==============================================================================

# HyperSync endpoint (default https://polygon.hypersync.xyz).
# ENVIO_POLYGON_HYPERSYNC_URL=https://polygon.hypersync.xyz

# Blocks per HyperSync request (default 6000).
# ENVIO_FULL_BATCH_SIZE=6000

# ==============================================================================
# START BLOCK
# ==============================================================================

# GLOBAL rewind only. When set, Envio substitutes this value into EVERY
# `${ENVIO_POLYGON_START_BLOCK:-N}` in config.yaml (chain + all contracts).
# Leave UNSET for per-contract deploy floors (V3=22757547, Algebra=34502463, …).
# ENVIO_POLYGON_START_BLOCK=4931780
# Alias bridged by bun run dev when ENVIO_POLYGON_START_BLOCK is unset:
# POLYGON_START_BLOCK=4931780

# ==============================================================================
# INDEXER PROGRESS STRIDES
# ==============================================================================

# INDEXER_PROGRESS_REALTIME_START=65000000
# INDEXER_PROGRESS_HISTORICAL_EVERY=4000
# INDEXER_PROGRESS_REALTIME_EVERY=500

# ==============================================================================
# INCOMPLETE-ROW REPAIR (onBlock) — Algebra / Balancer / DODO
# ==============================================================================

# ALGEBRA_META_REPAIR_EVERY=5000
# ALGEBRA_META_REPAIR_BATCH=8
# ALGEBRA_META_REPAIR_START=65000000

# BALANCER_POOLTYPE_REPAIR_EVERY=2000
# BALANCER_POOLTYPE_REPAIR_BATCH=8
# BALANCER_POOLTYPE_REPAIR_START=65000000

# DODO_FEE_REPAIR_EVERY=5000
# DODO_FEE_REPAIR_BATCH=8
# DODO_FEE_REPAIR_START=65000000

# ==============================================================================
# CURVE BOOTSTRAP (onBlock factory pagination)
# ==============================================================================

# First durable block for Effect-heavy pool_count/pool_list bootstrap (code default 90000000).
# Preload blocks are skipped; set this only to change the durable start.
# CURVE_BOOTSTRAP_FROM_BLOCK=90000000
# CURVE_BOOTSTRAP_EVERY=100
# CURVE_BOOTSTRAP_GROWTH_EVERY=100000
# CURVE_BOOTSTRAP_POOLS_PER_FIRE=8

# ==============================================================================
# FACTORY EVENT RECON (HyperSync catch-up — primary safety net)
# ==============================================================================

# First durable block for HyperSync event reconciliation (default 90000000).
# Preload blocks are skipped; set this only to change the durable start.
# FACTORY_EVENT_RECONCILIATION_FROM_BLOCK=90000000
# FACTORY_EVENT_RECONCILIATION_EVERY=10000
# FACTORY_EVENT_RECONCILIATION_PAGES=5

# ==============================================================================
# V2 allPairs RECON (OPT-IN — disabled unless FROM_BLOCK is set)
# ==============================================================================

# Redundant with factory onEvent + HyperSync PairCreated recon. Enable only if
# you need tip-state allPairs enumeration as an extra safety net.
# V2_RECONCILIATION_FROM_BLOCK=90000000
# V2_RECONCILIATION_EVERY=10000

# ==============================================================================
# POSTGRES (migrate-db / backup-db / repair-balancer-pooltype)
# ==============================================================================

# Preferred connection string for bun run migrate-db.
# PG_URL=postgres://postgres:testing@localhost:5433/envio-dev
# Fallbacks: ENVIO_PG_URL, DATABASE_URL, then ENVIO_POSTGRES_* docker defaults.
# ENVIO_POSTGRES_HOST=localhost
# ENVIO_POSTGRES_PORT=5433
# ENVIO_POSTGRES_USER=postgres
# ENVIO_POSTGRES_PASSWORD=testing
# ENVIO_POSTGRES_DB=envio-dev
# ENVIO_POSTGRES_CONTAINER=envio-postgres
# BACKUP_DIR=backups

# ==============================================================================
# PATHS
# ==============================================================================

# TOKEN_REGISTRY_DB=data/token_registry.db
# POOLS_JSON=data/pools.json

# ==============================================================================
# NODE / DEV WRAPPER (scripts/envio-dev.ts)
# ==============================================================================

# V8 heap MB for historical backfill (default 8192).
# ENVIO_NODE_MAX_OLD_SPACE_MB=8192

# Grace ms before SIGKILL of other indexer processes for this repo (default 2000).
# ENVIO_KILL_GRACE_MS=2000

# ==============================================================================
# LOGGING
# ==============================================================================

# Envio console log level.
# LOG_LEVEL=info
